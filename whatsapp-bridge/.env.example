PORT=3001

# Must match services.whatsapp_bridge.api_key in the Laravel app's .env
BRIDGE_API_KEY=

# Where Laravel's webhook endpoint lives
LARAVEL_WEBHOOK_URL=http://127.0.0.1:8010/api/whatsapp/webhook

# Must match services.whatsapp_bridge.webhook_secret in the Laravel app's .env
WEBHOOK_SECRET=
